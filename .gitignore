# Unity gitignore template
# Recommended for Unity projects: https://github.com/github/gitignore/blob/main/Unity.gitignore

# [Library] and [Temp] folders are Unity's local cache/work directories and must be ignored.
Library/
Temp/
Obj/
Build/
Builds/
Logs/
UserSettings/
MemoryCaptures/
.utmp/

# Ignore asset meta files for folders that are ignored (Unity will recreate them)
/[Cc]oin [Ss]ort [Mm]aster/Library.meta
/[Cc]oin [Ss]ort [Mm]aster/Temp.meta
/[Cc]oin [Ss]ort [Mm]aster/Obj.meta
/[Cc]oin [Ss]ort [Mm]aster/Build.meta
/[Cc]oin [Ss]ort [Mm]aster/Builds.meta
/[Cc]oin [Ss]ort [Mm]aster/Logs.meta
/[Cc]oin [Ss]ort [Mm]aster/UserSettings.meta
/[Cc]oin [Ss]ort [Mm]aster/MemoryCaptures.meta
/[Cc]oin [Ss]ort [Mm]aster/.utmp.meta

# MSVC free memory info
FreeImage.dll
FreeImageNET.dll
FreeImageNET.xml
x64/
x86/

# Autogenerated VS/MD/Consulo solution and project files
/[Cc]oin [Ss]ort [Mm]aster/ExportedObj/
/[Cc]oin [Ss]ort [Mm]aster/.vs/
/[Cc]oin [Ss]ort [Mm]aster/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.sln.docstate

# Unity Auto-generated Assets
/[Cc]oin [Ss]ort [Mm]aster/Assets/AssetStoreTools*
/[Cc]oin [Ss]ort [Mm]aster/Assets/AssetStoreTools.meta

# Unity WebGL build output
/[Cc]oin [Ss]ort [Mm]aster/Assets/StreamingAssets/build.info

# Unity crash reports
sysinfo.txt
CrashReport-*.txt

# OS/System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
